{
  "name": "yankeeswap",
  "version": "2.0.0",
  "private": true,
  "description": "Host a digital Yankee Swap from a phone, TV, and player seats",
  "keywords": [
    "yankee-swap",
    "white-elephant",
    "gift-exchange",
    "typescript",
    "react",
    "pwa"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint shared server/src client/src && tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "author": "Full Stack Boston / Jonaldo Alix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonaldoalix/yankeeswap.git"
  },
  "bugs": {
    "url": "https://github.com/jonaldoalix/yankeeswap/issues"
  },
  "homepage": "https://yankee.fullstackboston.com",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "^9.2.0",
    "oxlint": "^1.78.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.8",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2"
  }
}
